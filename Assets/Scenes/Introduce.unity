  m_Name: 
  m_EditorClassIdentifier: 
  authors:
  - name: dog_and_lamb
    nameImage: {fileID: 0}
    portrait: {fileID: 21300000, guid: 5b71537a5342f614eae500966a53c871, type: 3}
    roles: "\u5C0F\u5C0F\u7684\u8D1F\u8D23\u4E00\u90E8\u5206\u7684\u7F8E\u672F\u3001\u97F3\u4E50\u3001\u7A0B\u5E8F\u3002\u4E5F\u8BB8\u5E26\u7740\u4E9B\u7EC4\u957F\u7684\u529F\u80FD\u7F62\u4E86(^w^)"
    roleImage: {fileID: 0}
    message: "\u771F\u7684\u7279\u522B\u611F\u8C22\u6BCF\u4F4D\u6210\u5458\u7684\u4ED8\u51FA\uFF0C\u6211\u5E0C\u671B\u8FD9\u4E2A\u6E38\u620F\u80FD\u7ED9\u4F60\u4EEC\u3001\u73A9\u5BB6\u5E26\u53BB\u6E29\u6696\u4E0E\u5F00\u5FC3\u3002HUG
      HUG \u6E29\u6696\u76F8\u968F\u03BE( \uFF1Ew')\u3002\u4E5F\u5341\u5206\u611F\u8C22\u672C\u6B21GGJ\u7ED9\u4E88\u6211\u4EEC\u7684\u5B9D\u8D35\u7684\u505A\u6E38\u620F\u7684\u673A\u4F1A"
    messageImage: {fileID: 0}
    fontForText: {fileID: 0}
    roleBoxBackground: {fileID: 21300000, guid: 170d48959d3c6194ab926106f257e66f, type: 3}
    messageBoxBackground: {fileID: 0}
  - name: "\u591C\u660E\u7802"
    nameImage: {fileID: 21300000, guid: dad2e202abd0ee849be967c9f309e0ef, type: 3}
    portrait: {fileID: 21300000, guid: 6a910fced8f73c2469b73eeec4515b4b, type: 3}
    roles: "\u54B1\u4EEC\u7684\u5927\u5927\u5927\u6E38\u620F\u7B56\u5212\uFF0C\u5199\u4E86\u4EFD\u5341\u5206\u5341\u5206\u8BE6\u5C3D\u7684\u7B56\u5212\u6848\uFF0C\u5E76\u79EF\u6781\u6295\u5165\u7F8E\u672F\uFF0C\u97F3\u4E50\u4E0E\u90E8\u5206\u7A0B\u5E8F\u4E2D"
    roleImage: {fileID: 0}
    message: "Saki\u9171Saki\u9171Saki\u9171Saki\u9171Saki\u9171Saki\u9171\uFF01Saki\u9171Saki\u9171Saki\u9171Saki\u9171Saki\u9171Saki\u9171\uFF01Saki\u9171Saki\u9171Saki\u9171Saki\u9171Saki\u9171Saki\u9171\uFF01Saki\u9171Saki\u9171Saki\u9171Saki\u9171Saki\u9171Saki\u9171\uFF01Saki\u9171Saki\u9171Saki\u9171Saki\u9171Saki\u9171Saki\u9171\uFF01\u2191\u2191\u2193\u2193\r\n"
    messageImage: {fileID: 0}
    fontForText: {fileID: 0}
    roleBoxBackground: {fileID: 0}
    messageBoxBackground: {fileID: 0}
  - name: 'whalelllll '
    nameImage: {fileID: 0}
    portrait: {fileID: 21300000, guid: eb9d7aade78a5284b8309c16acd8759e, type: 3}
    roles: "whale\uFF01\uFF01\uFF01\uFF01\uFF01\uFF01\u4E3B\u7F8E\u672F\uFF0C\u4EE5\u53CA\u4E0E\u591C\u660E\u7802\u4E00\u8D77\u8D1F\u8D23\u97F3\u4E50\u3002\u5E76\u63D0\u51FA\u5976\u9F99\u7684\u5173\u952E\u8981\u7D20\uFF01\u5976\u9F99\u592A\u53EF\u7231\u5566~"
    roleImage: {fileID: 21300000, guid: c7359bb6ba45715448e4de5a50497e0f, type: 3}
    message: "\u9752 \u5C71 \u521A \u660C \u51AF \u865A \u5FA1 \u98CE\n\uFF08dogandlamb:guess
      what's happening to a cartoon near 2026.1?(*\xB4\u0437\uFF40*)\uFF09"
    messageImage: {fileID: 21300000, guid: ce5832e4ebc7c6d48861b70fb1d27922, type: 3}
    fontForText: {fileID: 0}
    roleBoxBackground: {fileID: 0}
    messageBoxBackground: {fileID: 0}
  - name: "\u4E5D\u6843\u554A "
    nameImage: {fileID: 21300000, guid: cdbb36484079da84e811d7f111552a49, type: 3}
    portrait: {fileID: 21300000, guid: 6a36f088004c2414bb8c6225b9c01045, type: 3}
    roles: "\u4E0E\u591C\u660E\u7802\u4E00\u8D77\u505A\u4E86\u8BB8\u591A\u7B56\u5212\u7684\u5DE5\u4F5C\u3002\u4E3A\u4F60\u70B9\u8D5E\uFF0C\u671F\u5F85\u4E0B\u6B21\u76F8\u4F1A~"
    roleImage: {fileID: 21300000, guid: c5c58b80c854a21409b8324c9c810db9, type: 3}
    message: "\u201C\u73A9\u6E38\u620F\u5F53\u7136\u662F\u8981\u7B11\u7740\u73A9\u5566\uFF01\u201D\r\n\uFF08\u556A\u5527\u4E00\u4E0B\u88ABboss\u79D2\u4E86\uFF09\r\n\uFF08\u6253\u4E86\u4E24\u4E2A\u534A\u5C0F\u65F6\u7EA2\u6E29\u5230\u9752\u7B4B\u66B4\u8D77\uFF09\r\n\u201C\u554A\u54C8\u4F60\u5E72\u561B~\u54CE\u5466~\u201D\r\nPs\uFF1A\u6635\u79F0\u662F\u95FD\u5357\u8BDD\u5566Ciallo(\u2220\u30FB\u03C9<
      )\u2312\u2606\r\n(dogandlamb:\u5927\u9EC4\u8702\u4E0D\u597D\uFF1F)"
    messageImage: {fileID: 21300000, guid: cfccc05c79e568a47acce33bdf92219c, type: 3}
    fontForText: {fileID: 0}
    roleBoxBackground: {fileID: 0}
    messageBoxBackground: {fileID: 0}
  - name: "\u5730\u7403\u4EEA"
    nameImage: {fileID: 21300000, guid: f66afea64eedd7547a061f9eec55977b, type: 3}
    portrait: {fileID: 21300000, guid: fb104f68c21d75c4fb780a1ce919e4cd, type: 3}
    roles: "\u4E0E\u5341\u5206\u53EF\u7231^-^\u7684whalelllll\u4E3A\u6574\u4E2A\u6E38\u620F\u5960\u5B9A\u7684\u7F8E\u672F\u57FA\u8C03\u3002
      \u201C\u753B\u8239\u82B1\u822B\u603B\u65B0\u5986\uFF0C\u8FDB\u5165\u6C60\u5FC3\u8FD1\u5C9B\u508D\u201D"
    roleImage: {fileID: 21300000, guid: 4fc4732059bca5c4ab7115ad86bb50b1, type: 3}
    message: "\u628A\u5976\u9F99\u753B\u7684\u8FD9\u4E48\u53EF\u7231\u771F\u662F\u62B1\u6B49;)\ndogandlamb:\u4E0D\u53EF\u7231\u7684\u8BDD\u6211\u5C31\u505A\u6050\u6016\u6E38\u620F\u4E86(\uFF9F\u03C9\xB4)"
    messageImage: {fileID: 21300000, guid: 836eef4a3cadb6a40ba37a83353682bc, type: 3}
    fontForText: {fileID: 0}
    roleBoxBackground: {fileID: 0}
    messageBoxBackground: {fileID: 0}
  - name: "\u6770\u5821"
    nameImage: {fileID: 21300000, guid: 689212f01ec78264fb6905747b2d6f23, type: 3}
    portrait: {fileID: 21300000, guid: 0b65d02b1bcbbbe47bc057c38b88b916, type: 3}
    roles: "\u8D1F\u8D23\u7B2C\u4E09\u5173\u7684\u7A0B\u5E8F\u4EE3\u7801\uFF0C\u6587\u5B57\u6E38\u620F\u201D\u6770\u201C\u51FA\u5927\u5E08"
    roleImage: {fileID: 21300000, guid: eaecb0cb600524b458ad455d46dc6162, type: 3}
    message: 
    messageImage: {fileID: 21300000, guid: 2bdaec03590c5bd4fa2a9e3cc0a680f3, type: 3}
