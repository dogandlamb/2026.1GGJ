    roles: "\u7B2C\u4E00\u5173\u7684\u7A0B\u5E8F\uFF0C\u4E0D\u8FC7\u5728\u6253\u6D6A\u6F2B\u624B\u673A(-V-)\u3002\u867D\u7136\u7B2C\u4E00\u5173\u6CA1\u505A\u51FA\u6765\uFF0C\u4F46GGJ\u8FD9\u6BB5\u65C5\u7A0B\u8DB3\u591F\u7CBE\u5F69\u5C31\u597D\u5566\uFF0CHave
      fun~"
    roleImage: {fileID: 21300000, guid: 9e2ea7202b3491f478003cb7f0235435, type: 3}
    message: "\u6CA1\u6709\u505A\u5B8C\u771F\u662F\u62B1\u6B49\n\uFF08dogandlamb\uFF1A\u4E00\u56DE\u751F\uFF0C\u4E8C\u56DE\u719F\uFF0C\u4E0B\u6B21\u89C1\u9762\u4F1A\u66F4\u597D\uFF01^-^\uFF09"
